{
  "title": "agentic-os option/command swap",
  "rules": [
    {
      "description": "Swap left_option and left_command (external keyboard)",
      "manipulators": [
        {
          "from": { "key_code": "left_option", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_command" }],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "vendor_id": 21579, "product_id": 8 }]
            }
          ],
          "type": "basic"
        },
        {
          "from": { "key_code": "left_command", "modifiers": { "optional": ["any"] } },
          "to": [{ "key_code": "left_option" }],
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [{ "vendor_id": 21579, "product_id": 8 }]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
