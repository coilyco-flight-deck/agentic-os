# RENDERED FILE - do not edit by hand.
# Source of truth: agentic-os/warp/templates/settings.toml.tmpl
# Rendered to Warp's config dir by `ward exec warp apply`.

[notifications]
toast_duration_secs = 8

[notifications.preferences]
is_agent_task_completed_enabled = true
is_long_running_enabled = true
is_needs_attention_enabled = true
is_password_prompt_enabled = true
long_running_threshold = 30
mode = "enabled"
play_notification_sound = true

[privacy]
crash_reporting_enabled = true
telemetry_enabled = true
custom_secret_regex_list = [
  # Public IPv4 only. Excludes loopback (127.0.0.0/8, 0.0.0.0/8), RFC1918
  # private (10/8, 172.16/12, 192.168/16), and link-local (169.254/16) per
  # the agentic-os-kai/AGENTS.md "RFC1918 + loopback are not opaque ids"
  # rule. CGNAT (100.64/10, where tailnet IPs live) is intentionally NOT
  # excluded so tailnet IPs still get flagged.
  #
  # Lookahead-free: Warp's secret-detection engine is Rust's `regex` crate,
  # which rejects `(?!...)`. The exclusions are expressed by enumerating the
  # allowed first/second octet ranges instead. First octet excludes 0/10/127
  # entirely; 169 excludes second-octet 254; 172 excludes 16-31; 192 excludes
  # 168. Trailing two octets are unrestricted 0-255.
  {
    name = "Public IPv4 Address",
    pattern = '\b(?:(?:[1-9]|1[1-9]|[2-9]\d|1[01]\d|12[0-6]|12[89]|1[3-5]\d|16[0-8]|17[01]|17[3-9]|18\d|19[01]|19[3-9]|2[0-4]\d|25[0-5])\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)|169\.(?:255|25[0-3]|2[0-4]\d|1\d\d|[1-9]?\d)|172\.(?:25[0-5]|2[0-4]\d|1\d\d|3[2-9]|[4-9]\d|1[0-5]|[0-9])|192\.(?:25[0-5]|2[0-4]\d|1[7-9]\d|16[0-7]|1[0-5]\d|169|[1-9]?\d))(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){2}\b',
  },
  {
    name = "IPv6 Address",
    pattern = '\b((([0-9A-Fa-f]{1,4}:){1,6}:)|(([0-9A-Fa-f]{1,4}:){7}))([0-9A-Fa-f]{1,4})\b',
  },
  { name = "Slack App Token", pattern = '\bxapp-[0-9]+-[A-Za-z0-9_]+-[0-9]+-[a-f0-9]+\b' },
  {
    name = "AWS Access ID",
    pattern = '\b(AKIA|A3T|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{12,}\b',
  },
  {
    name = "MAC Address",
    pattern = '\b((([a-zA-z0-9]{2}[-:]){5}([a-zA-z0-9]{2}))|(([a-zA-z0-9]{2}:){5}([a-zA-z0-9]{2})))\b',
  },
  { name = "Google API Key", pattern = '\bAIza[0-9A-Za-z-_]{35}\b' },
  { name = "Google OAuth ID", pattern = '\b[0-9]+-[0-9A-Za-z_]{32}\.apps\.googleusercontent\.com\b' },
  { name = "GitHub Classic Personal Access Token", pattern = '\bghp_[A-Za-z0-9_]{36}\b' },
  { name = "GitHub Fine-Grained Personal Access Token", pattern = '\bgithub_pat_[A-Za-z0-9_]{82}\b' },
  { name = "GitHub OAuth Access Token", pattern = '\bgho_[A-Za-z0-9_]{36}\b' },
  { name = "GitHub User-to-Server Token", pattern = '\bghu_[A-Za-z0-9_]{36}\b' },
  { name = "GitHub Server-to-Server Token", pattern = '\bghs_[A-Za-z0-9_]{36}\b' },
  { name = "Stripe Key", pattern = '\b(?:r|s)k_(test|live)_[0-9a-zA-Z]{24}\b' },
  { name = "Firebase Auth Domain", pattern = '\b([a-z0-9-]){1,30}(\.firebaseapp\.com)\b' },
  { name = "JWT", pattern = '\b(ey[a-zA-z0-9_\-=]{10,}\.){2}[a-zA-z0-9_\-=]{10,}\b' },
  { name = "OpenAI API Key", pattern = '\bsk-[a-zA-Z0-9]{48}\b' },
  { name = "Anthropic API Key", pattern = '\bsk-ant-api\d{0,2}-[a-zA-Z0-9\-]{80,120}\b' },
  { name = "Generic SK API Key", pattern = '\bsk-[a-zA-Z0-9\-]{10,100}\b' },
  { name = "Fireworks API Key", pattern = '\bfw_[a-zA-Z0-9]{24}\b' },
]

[privacy.secret_redaction]
enabled = false

[appearance]
spacing = "normal"

[appearance.full_screen_apps]
alt_screen_padding = { custom = { uniform_padding = 0.0 } }

[appearance.input]
input_mode = "pinned_to_bottom"

[appearance.text]
font_size = 11.0
notebook_font_size = 14.0

[appearance.themes]
theme = { custom = { name = "Coilysiren Sombra (Wallpaper)", path = "{{ .ThemePath }}" } }

[appearance.tabs]
workspace_decoration_visibility = "always_show"

[appearance.tabs.header_toolbar_chip_selection]

[appearance.tabs.header_toolbar_chip_selection.custom]
left = ["tabs_panel", "tools_panel"]
right = ["notifications_mailbox"]

[appearance.vertical_tabs]
enabled = false
primary_info = "command"
compact_subtitle = "command"
view_mode = "expanded"
display_granularity = "tabs"
tab_item_mode = "focused_session"

[appearance.icon]
app_icon = "default"

[appearance.window]
zoom_level = 150

[terminal]

[terminal.input]
alias_expansion_enabled = true
completions_open_while_typing = true

[general]
default_session_mode = "terminal"
default_tab_config_path = "{{ .TabConfigPath }}"
login_item = true

[workflows]
show_global_workflows_in_universal_search = true

[agents]
# Kai uses Claude Code for AI work; Warp is terminal-only.
# Master kill switch is [agents.warp_agent] is_any_ai_enabled = false below.
# The sub-knobs (input.*, profiles.*, knowledge.*, active_ai.*) are defense
# in depth so noise stays gone if the master ever flips back on.
#
# cloud_conversation_storage_enabled is special: Warp rewrites this from
# cloud account state on every launch regardless of is_settings_sync_enabled.
# To actually disable, toggle the corresponding option in Warp's UI; Warp
# will then write false here. PENDING: still true because the UI toggle
# has not been flipped post-Preview-swap. Flip it in WarpPreview Settings
# next time settings.toml gets opened. Because Warp owns this value, `warp
# doctor` treats it as volatile (see volatileSettingsKeys in main.go): its
# drift is a NOTE, not a FAIL. Same for zoom_level under [appearance.window].
cloud_conversation_storage_enabled = true

[agents.mcp_servers]
file_based_mcp_enabled = false

[agents.profiles]
agent_mode_execute_readonly_commands = false

[agents.warp_agent]
is_any_ai_enabled = false

[agents.warp_agent.input]
nld_in_terminal_enabled = false
ai_auto_detection_enabled = false

[agents.warp_agent.active_ai]
rule_suggestions_enabled = false

[agents.knowledge]
rules_enabled = false
warp_drive_context_enabled = false

[agents.third_party]
# Auto-opening Warp's composer panel on Claude Code start is AI-adjacent
# surface noise we don't want, given is_any_ai_enabled = false above.
auto_open_composer_on_cli_agent_start = false
cli_agent_toolbar_chip_selection_setting = "default"

[warpify]

[warpify.ssh]
# Warp auto-injects a POSIX bootstrap (`export ...`) into every ssh session
# its command layer intercepts. That breaks non-POSIX remote shells: a
# Windows OpenSSH cmd.exe host dies on the first `export`, closing the
# session instantly. Disable the blanket auto-warpification and rely on the
# explicit added_subshell_commands list below, which still warpifies the
# hosts we curate (kai-server) without touching Windows boxes.
enable_ssh_warpification = false

[warpify.subshells]
added_subshell_commands = [
  "docker compose .* run .*",
  "docker container exec .*",
  "ssh kai@kai-server",
  "ward ssh .*",
]

[code]

[code.indexing]
agent_mode_codebase_context_auto_indexing = false

[code.editor]
open_file_layout = "new_tab"
open_file_editor = "warp"
show_code_review_button = false

[account]
# This file is the source of truth; the repo wins, not Warp's cloud sync.
# Flipping back to true would let Warp overwrite the rendered file on every
# settings-touch from any device. See docs/warp.md.
is_settings_sync_enabled = false

[session]

[session.working_directory_config]
advanced_mode = false
global = { custom_dir = "{{ .StartupDir }}", mode = "custom_dir" }
new_tab = { custom_dir = "{{ .StartupDir }}", mode = "custom_dir" }
new_window = { custom_dir = "{{ .StartupDir }}", mode = "custom_dir" }
split_pane = { custom_dir = "", mode = "previous_dir" }
