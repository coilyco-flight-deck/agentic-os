{
  "statusLine": {
    "type": "command",
    "command": "/opt/agentic-os/agent-name.sh statusline",
    "padding": 2
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/agentic-os/agent-name.sh sessionstart"
          }
        ]
      }
    ]
  }
}
