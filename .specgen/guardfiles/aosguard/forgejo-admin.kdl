// Forgejo operations Forgejo refuses to the coilyco-ops bot, which is an org
// member holding push rather than an owner holding repo-admin. The separate
// wrapper keeps ordinary reads and writes on the bot token. Rationale:
// ../../../docs/aosguard.md.
wrap aosguard ops forgejo-admin {
    // Same store and shape as the ordinary wrapper, pointed at the admin PAT.
    provider ssm {
        exec aws ssm get-parameter --with-decryption --output text --query "Parameter.Value" --name
    }

    spec forgejo-admin.swagger.v1.json.gz
    base-url "forgejo.coilysiren.me/api/v1"
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/admin-token"
    }
    restrict owner matches coily*

    // Repo settings and cosmetics. EditRepoOption carries the merge policy
    // forgejo-repo-settings.py converges; `private` and `archived` ride along.
    can edit repo
    can get repo {
        describe "read a repository's current settings, so a converge can diff before it writes"
    }
    can replace-all repo-topic {
        op repoUpdateTopics
        describe "replace the complete repository topic set (PUT /repos/{owner}/{repo}/topics); repeat --topics for each retained topic"
    }

    // Org labels: every write needs org ownership, which is why the ordinary
    // wrapper answers a pointer here. Reads stay available on both.
    can get org-label
    can list org-label
    can create org-label {
        describe "mint an org label (POST /orgs/{org}/labels); pass --exclusive for a scoped group like priority/* or autonomy/* so the tracker enforces one value per issue"
    }
    can edit org-label {
        describe "rename or restyle an org label in place (PATCH /orgs/{org}/labels/{id}). An edit keeps the label id, so every issue carrying it keeps it through a rename - this is the safe way to move a taxonomy"
    }
    can delete org-label {
        describe "irreversible: removes the label from every issue that carries it. Prefer `edit org-label` for a rename, which preserves those associations"
    }

    // Branch protection: converged whenever the repo set changes, most often
    // right after creating a repo, so it is routine rather than exceptional.
    can list branch-protection {
        op repoListBranchProtection
        describe "list the protection rules on a repository (GET /repos/{owner}/{repo}/branch_protections). op pinned because a bare `list branch` resolves here rather than to the branch list"
    }
    can get branch-protection {
        op repoGetBranchProtection
    }
    can create branch-protection {
        op repoCreateBranchProtection
        describe "protect a branch (POST /repos/{owner}/{repo}/branch_protections). Run it on a newly created repo, which starts unprotected"
    }
    can edit branch-protection {
        op repoEditBranchProtection
        describe "converge an existing rule (PATCH /repos/{owner}/{repo}/branch_protections/{name}). Idempotent: re-running a matching rule changes nothing"
    }
}
