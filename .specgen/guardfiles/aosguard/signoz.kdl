// Every leaf fixes one exact tool on the pre-authenticated SigNoz MCP.
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops signoz {
    exec mcporter

    can run "metrics list" {
        argv "call" "signoz.signoz_list_metrics" "--output" "json"
        allow-flag --help
        describe "list available SigNoz metrics"
    }
    can run "metrics query" {
        argv "call" "signoz.signoz_query_metrics" "--output" "json"
        allow-flag --help
        describe "query SigNoz metrics"
    }
    can run "metrics top" {
        argv "call" "signoz.signoz_get_top_metrics" "--output" "json"
        allow-flag --help
        describe "list top SigNoz metrics"
    }
    can run "metrics usage" {
        argv "call" "signoz.signoz_check_metric_usage" "--output" "json"
        allow-flag --help
        describe "check where a SigNoz metric is used"
    }
    can run "metrics cardinality" {
        argv "call" "signoz.signoz_check_metric_cardinality" "--output" "json"
        allow-flag --help
        describe "check SigNoz metric cardinality"
    }
    can run "fields keys" {
        argv "call" "signoz.signoz_get_field_keys" "--output" "json"
        allow-flag --help
        describe "list SigNoz field keys"
    }
    can run "fields values" {
        argv "call" "signoz.signoz_get_field_values" "--output" "json"
        allow-flag --help
        describe "list values for a SigNoz field"
    }
    can run "alerts active" {
        argv "call" "signoz.signoz_list_alerts" "--output" "json"
        allow-flag --help
        describe "list active SigNoz alerts"
    }
    can run "alerts rules" {
        argv "call" "signoz.signoz_list_alert_rules" "--output" "json"
        allow-flag --help
        describe "list SigNoz alert rules"
    }
    can run "alerts get" {
        argv "call" "signoz.signoz_get_alert" "--output" "json"
        allow-flag --help
        describe "get one SigNoz alert"
    }
    can run "alerts history" {
        argv "call" "signoz.signoz_get_alert_history" "--output" "json"
        allow-flag --help
        describe "get SigNoz alert history"
    }
    can run "dashboards list" {
        argv "call" "signoz.signoz_list_dashboards" "--output" "json"
        allow-flag --help
        describe "list SigNoz dashboards"
    }
    can run "dashboards get" {
        argv "call" "signoz.signoz_get_dashboard" "--output" "json"
        allow-flag --help
        describe "get one SigNoz dashboard"
    }
    can run "dashboards templates" {
        argv "call" "signoz.signoz_list_dashboard_templates" "--output" "json"
        allow-flag --help
        describe "list curated SigNoz dashboard templates"
    }
    can run "services list" {
        argv "call" "signoz.signoz_list_services" "--output" "json"
        allow-flag --help
        describe "list SigNoz APM services"
    }
    can run "services operations" {
        argv "call" "signoz.signoz_get_service_top_operations" "--output" "json"
        allow-flag --help
        describe "list top operations for a SigNoz service"
    }
    can run "views list" {
        argv "call" "signoz.signoz_list_views" "--output" "json"
        allow-flag --help
        describe "list saved SigNoz Explorer views"
    }
    can run "views get" {
        argv "call" "signoz.signoz_get_view" "--output" "json"
        allow-flag --help
        describe "get one saved SigNoz Explorer view"
    }
    can run "docs search" {
        argv "call" "signoz.signoz_search_docs" "--output" "json"
        allow-flag --help
        describe "search official SigNoz documentation"
    }
    can run "docs fetch" {
        argv "call" "signoz.signoz_fetch_doc" "--output" "json"
        allow-flag --help
        describe "fetch one official SigNoz documentation page"
    }
    can run "logs aggregate" {
        argv "call" "signoz.signoz_aggregate_logs" "--output" "json"
        allow-flag --help
        describe "aggregate SigNoz log records"
    }
    can run "logs search" {
        argv "call" "signoz.signoz_search_logs" "--output" "json"
        allow-flag --help
        describe "search SigNoz log records"
    }
    can run "traces aggregate" {
        argv "call" "signoz.signoz_aggregate_traces" "--output" "json"
        allow-flag --help
        describe "aggregate SigNoz traces"
    }
    can run "traces search" {
        argv "call" "signoz.signoz_search_traces" "--output" "json"
        allow-flag --help
        describe "search SigNoz traces"
    }
    can run "traces get" {
        argv "call" "signoz.signoz_get_trace_details" "--output" "json"
        allow-flag --help
        describe "get one complete SigNoz trace"
    }
    can run "channels list" {
        argv "call" "signoz.signoz_list_notification_channels" "--output" "json"
        allow-flag --help
        describe "list SigNoz notification-channel summaries"
    }
}
