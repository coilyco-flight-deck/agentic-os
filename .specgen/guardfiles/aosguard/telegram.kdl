// CI failure alerting as one verb, shared by every repository.
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops telegram {
    exec python3

    can run alert {
        argv "-I"
        embed "alert_telegram.py"
        sealed
        describe "post this job's CI or CD failure to the signoz-telegram mapper; every field is read from the runner's own GITHUB_* environment"
    }
}
