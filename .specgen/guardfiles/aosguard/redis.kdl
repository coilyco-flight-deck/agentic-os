// aosguard ops redis - the Redis read surface as an allowlist (umbra execverb,
// exec dialect). Wraps redis-cli from redis-tools in the dev-base image.
//
// The store this exists for is the shared mcp-beaver rate-limit bucket in
// coilyco-bridge/deploy services/mcp-ratelimit. Its whole content is a few
// small keys with TTLs, which is why `keys` is exposed at all: on a store this
// size the O(N) objection does not apply, and `scan` is here for the habit.
//
// AUTH COMES FROM THE ENVIRONMENT, NEVER FROM ARGV. redis-cli reads
// REDISCLI_AUTH, and the two flags that would take a password on the command
// line - `-a` and `-u` - are absent from every allowlist below, so the guard
// rejects them. That is enforcement rather than convention: a flag not named in
// an `allow-flag` list is refused before the process runs.
//
// WRITES ARE NOT HERE, AND THE REASON IS MONEY. A bucket key holds a spend
// budget, so `set` fabricates budget and `flushall` resets every budget at
// once. Neither is an agent verb. `del` is the one exception and is exposed
// deliberately: unsticking a single wedged bucket is ordinary operations, and
// it is bounded to one key at a time. `config set` stays denied because
// maxmemory-policy is load-bearing - moving it off noeviction turns an eviction
// into a silent budget reset, which is the failure the store exists to prevent.
wrap aosguard ops redis {
    exec redis-cli

    can run ping {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "liveness check: PONG if the server is up and the password was accepted"
    }
    can run info {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "server state; pass a section such as persistence to confirm AOF is enabled, or memory, clients, stats"
    }
    can run dbsize {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "how many keys the database holds"
    }
    can run get {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "read one key's value; pass the key name"
    }
    can run ttl {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "seconds until a key expires; -1 means no expiry set, -2 means the key is gone"
    }
    can run exists {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "whether a key is present, without reading it"
    }
    can run type {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "the value type behind a key: string, hash, list, set, zset, stream"
    }
    can run keys {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "list keys matching a glob. O(N) and blocking on a large database; fine on the small rate-limit store this wraps, and prefer scan elsewhere"
    }
    can run scan {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "walk keys a cursor at a time without blocking the server; the polite form of keys"
    }
    can run "config get" {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "read running configuration, e.g. appendonly, appendfsync, maxmemory-policy, dir"
    }
    can run del {
        allow-flag -h
        allow-flag -p
        allow-flag -n
        describe "delete named keys. On a rate-limit store this GRANTS BUDGET by resetting the bucket it removes, so name the exact key and never a sweep"
    }

    // intentionally unexposed - budget fabrication, mass reset, and the
    // settings whose change would make an eviction look like a normal miss
    never run set
    never run setex
    never run mset
    never run incr
    never run decr
    never run expire
    never run persist
    never run flushall
    never run flushdb
    never run "config set"
    never run "config resetstat"
    never run shutdown
    never run debug
    never run monitor
    never run replicaof
    never run slaveof
    never run migrate
    never run eval
    never run evalsha
    never run script
    never run function
    never run acl
    never run save
    never run bgsave
    never run bgrewriteaof
    never run "client kill"
}
