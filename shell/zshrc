#!/usr/bin/env zsh

if [[ "$SHELL" == *"bash"* ]]; then
  source "$HOME/.bashrc"
  exit 0
fi

ln -sf "$HOME/projects/coilyco-flight-deck/agentic-os/shell/zshrc" "$HOME/.zshrc"
source "$HOME/projects/coilyco-flight-deck/agentic-os/shell/common.sh"
# compinit before warp.zsh: it registers a completion via compdef.
autoload -Uz compinit && compinit
source "$HOME/projects/coilyco-flight-deck/agentic-os/shell/warp.zsh"
command -v direnv >/dev/null && eval "$(direnv hook zsh)"

# Machine-local overrides (host-specific PATH, aliases, functions). Public-safe: the line is generic; the content lives outside this repo.
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

# ripgrep: load config (enables --hidden so rg searches dotfiles by default)
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"
