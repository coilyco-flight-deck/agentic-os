#!/usr/bin/env bash

# Follow every hop, since a session shadow home links to the canonical link.
_siren_bashrc_source="${BASH_SOURCE[0]}"
while [ -L "$_siren_bashrc_source" ]; do
  _siren_link="$(readlink "$_siren_bashrc_source")"
  case "$_siren_link" in
    /*) _siren_bashrc_source="$_siren_link" ;;
    *) _siren_bashrc_source="$(dirname "$_siren_bashrc_source")/$_siren_link" ;;
  esac
done
unset _siren_link
_siren_aos_root="$(cd "$(dirname "$_siren_bashrc_source")/.." && pwd -P)"
export AOS_REPO_ROOT="$_siren_aos_root"
source "$_siren_aos_root/shell/common.sh"
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# Programmable completion (stock enablement).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

_siren_aterm_completion bash
