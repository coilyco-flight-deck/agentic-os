#!/usr/bin/env bash

_siren_bashrc_source="$(readlink "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
_siren_aos_root="$(cd "$(dirname "$_siren_bashrc_source")/.." && pwd -P)"
export AOS_REPO_ROOT="$_siren_aos_root"
source "$_siren_aos_root/shell/common.sh"
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# Programmable completion (stock enablement).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

_siren_aterm_completion bash
