#!/usr/bin/env bash

if [[ "$SHELL" == *"zsh"* ]]; then
  source "$HOME/.zshrc"
  exit 0
fi

ln -sf "$HOME/projects/coilyco-flight-deck/agentic-os/shell/bashrc" "$HOME/.bashrc"
source "$HOME/projects/coilyco-flight-deck/agentic-os/shell/common.sh"
source "$HOME/projects/coilyco-flight-deck/agentic-os/shell/warp.zsh"
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# Programmable completion (stock enablement).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi
