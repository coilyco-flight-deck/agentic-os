// Ward's shipped agent role presets. This is product-default data, not a guardfile
// or a fleet overlay. The embedded copy mirrors this canonical source.
roles {
    role engineer {
        tagline "Implements a ticket end to end."
        capabilities read engineering
        modes "A ref carries that issue detached, fire-and-forget. Freeform text files an issue first, then carries it. Detached-only - interactive work funnels to the director."
        posture code-landing
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
    }
    role director {
        tagline "Autonomously drives a repo's headless lane to drain."
        capabilities read project-management
        modes "Attached LLM-in-the-loop heartbeat over a repo's backlog (`--repo` scope). Surfaces a read-only scope + dispatch session on drain, no ref."
        // smart as they come
        posture attached
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.5
            reasoning-effort xhigh
        }
    }
    role advisor {
        tagline "Answers without writing code."
        capabilities read
        modes "A ref researches the issue and posts the answer as a comment. Freeform text answers inline."
        // smarter agents than baseline
        posture no-code
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort high
        }
        agent codex {
            model gpt-5.5
            reasoning-effort high
        }
    }
    role qa {
        tagline "Inspects a candidate and posts a structured verdict comment."
        capabilities read
        modes "A ref inspects the issue, branch, pull request, and checks, then posts a structured QA verdict comment. Freeform mode is not exposed."
        posture no-code
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
    }
    role ops {
        tagline "Perform live system maintenance and operations."
        capabilities read ops
        modes "A ref inspects the issue and surrounding runtime state, then uses only the role's declared guardfiles for cloud, cluster, and Forgejo follow-up. Freeform mode is not exposed."
        // smart as they come
        posture no-code
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.aws.kdl"
        guardfile "guardfile.kubectl.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.5
            reasoning-effort xhigh
        }
    }
}
