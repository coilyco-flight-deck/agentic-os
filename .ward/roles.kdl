// Fleet role -> guardfile bindings for the coilyco deployment. This is fleet
// overlay data (dialect 2), consumed by ward's fleet-config parser, which wants
// each role body to carry only `guardfile | guardfiles | agent` nodes. The role
// presets (tagline / capabilities / modes / posture) are ward-embedded product
// data and live in ward's tree, not in this overlay. See docs/ward-specs.md.
roles {
    role engineer {
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.merge.kdl"
    }
    role director {
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.runnertoken.kdl"
        guardfile "guardfile.forgejo.runnertoken.exec.kdl"
        guardfile "guardfile.forgejo.merge.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort xhigh
        }
        // Director codex rides the frontier model, distinct from the engineer
        // default (aos#450). Rationale: docs/ward-specs-overrides.md.
        agent codex {
            model gpt-5.6-sol
            reasoning-effort xhigh
            verbosity medium
        }
    }
    role advisor {
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort high
        }
        agent codex {
            model gpt-5.5
            reasoning-effort high
        }
    }
    role qa {
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
    }
    role ops {
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.runnertoken.kdl"
        guardfile "guardfile.forgejo.runnertoken.exec.kdl"
        guardfile "guardfile.aws.kdl"
        guardfile "guardfile.kubectl.kdl"
        agent claude {
            model claude-opus-4-8
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.5
            reasoning-effort xhigh
        }
    }
}
