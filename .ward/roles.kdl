roles {
    // engineer: write code, merge code, stay focused on your goal
    role engineer {
        // BEGIN generated role-intent harness routes
        intent autonomous-coding {
            harness openhands
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // guardfiles for dev
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.merge.kdl"
        // Keep the role-only overlay after the public AWS source in lexical
        // order. Ward's public exec mount keeps the first shared command path.
        guardfile "guardfile.aws.role-engineer.kdl"
        // make the agents average everyday fellows
        agent claude {
            model claude-opus-4-8
            // name "opal engineer"
            // pronouns she
            reasoning-effort high
        }
        agent codex {
            model gpt-5.6-terra
            // name "terran engineer"
            // pronouns he
            reasoning-effort high
        }
    }
    // director: pair with the human on high level goals
    role director {
        // BEGIN generated role-intent harness routes
        intent strategic-planning {
            harness plandex
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // guardfiles for project management
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.merge.kdl"
        // guardfiles for ops
        guardfile "guardfile.aws.kdl"
        guardfile "guardfile.tailscale.kdl"
        guardfile "guardfile.kubectl.kdl"
        guardfile "guardfile.forgejo.runnertoken.kdl"
        guardfile "guardfile.forgejo.runnertoken.exec.kdl"
        // make the agents as smart as they come
        agent claude {
            model claude-fable-5
            // name "fabled director"
            // pronouns she
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.6-sol
            // name "solar director"
            // pronouns he
            reasoning-effort xhigh
        }
    }
    // qa: pair with engineers on polishing code
    role qa {
        // BEGIN generated role-intent harness routes
        intent code-review {
            harness aider
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // make the agents average everyday fellows
        agent claude {
            model claude-opus-4-8
            // name "opal tester"
            // pronouns she
            reasoning-effort high
        }
        agent codex {
            model gpt-5.6-terra
            // name "terran tester"
            // pronouns he
            reasoning-effort high
        }
    }
    // advisor: in depth research and analysis
    role advisor {
        // BEGIN generated role-intent harness routes
        intent research-synthesis {
            harness hermes
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // guardfiles for ops
        guardfile "guardfile.aws.kdl"
        guardfile "guardfile.tailscale.kdl"
        guardfile "guardfile.kubectl.kdl"
        // make the agents lil bit smart
        agent claude {
            model claude-fable-5
            // name "fabled advisor"
            // pronouns she
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.6-sol
            // name "solar advisor"
            // pronouns he
            reasoning-effort xhigh
        }
    }
    // ops: investigate live systems and apply modifications and remediation
    role ops {
        // BEGIN generated role-intent harness routes
        intent ops-investigation {
            harness holmesgpt
        }
        intent operational-decision {
            harness goose
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // guardfiles for ops
        guardfile "guardfile.aws.kdl"
        guardfile "guardfile.tailscale.kdl"
        guardfile "guardfile.kubectl.kdl"
        guardfile "guardfile.forgejo.runnertoken.kdl"
        guardfile "guardfile.forgejo.runnertoken.exec.kdl"
        // make the agents as smart as they come
        agent claude {
            model claude-fable-5
            // name "fabled SRE"
            // pronouns she
            reasoning-effort xhigh
        }
        agent codex {
            model gpt-5.6-sol
            // name "solar SRE"
            // pronouns he
            reasoning-effort xhigh
        }
    }
    // pm: autonomous triage and project management
    role pm {
        // BEGIN generated role-intent harness routes
        intent strategic-planning {
            harness hermes
        }
        intent project-coordination {
            harness plane
        }
        // END generated role-intent harness routes

        // guardfiles for day to day read (defaults)
        guardfile "guardfile.forgejo.read.kdl"
        guardfile "guardfile.forgejo.readactions.kdl"
        // guardfiles for project management
        guardfile "guardfile.forgejo.write.kdl"
        guardfile "guardfile.forgejo.merge.kdl"
        // make the agents average everyday fellows
        agent claude {
            model claude-opus-4-8
            // name "opal planner"
            // pronouns she
            reasoning-effort high
        }
        agent codex {
            model gpt-5.6-terra
            // name "terran planner"
            // pronouns he
            reasoning-effort high
        }
    }
    // designer: shape product interactions and produce design artifacts
    role designer {
        // BEGIN generated role-intent harness routes
        intent product-shaping {
            harness penpot
        }
        intent design-production {
            harness aosx
        }
        // END generated role-intent harness routes
    }
    // social: social media leads and analysis
    role social {
        // BEGIN generated role-intent harness routes
        intent message-composition {
            harness mixpost
        }
        intent channel-publishing {
            harness elizaos
        }
        // END generated role-intent harness routes
    }
    // sales: brings in the money
    role sales {
        // BEGIN generated role-intent harness routes
        intent research-synthesis {
            harness hermes
        }
        intent conversation-management {
            harness elizaos
        }
        // END generated role-intent harness routes
    }
    // customer-success: onboarding, support, retention, and customer research
    role customer-success {
        // BEGIN generated role-intent harness routes
        intent knowledge-retrieval {
            harness rasa
        }
        intent conversation-management {
            harness rasa
        }
        // END generated role-intent harness routes
    }
}
