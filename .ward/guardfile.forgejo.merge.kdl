// Forgejo MERGE overlay - director-completion authority (agentic-os#446).
// Grants exactly the PR-merge pair: the repoMergePullRequest POST plus its
// idempotent repoPullRequestIsMerged read helper. This deliberately lives
// OUTSIDE the read -> write -> admin tier chain: advisor and qa inherit those
// shared tiers, and merge authority binds to the director and engineer roles
// only (roles.kdl), so it rides its own overlay the way the Actions log
// bridge does. It backs the `ward agent director merge` composite - merge
// only a PR whose issue thread authorizes director merge - so the guarded
// verb is the transport, not the policy: thread authorization stays with the
// composite. Actions rerun is intentionally absent (the pinned swagger has no
// rerun operationId); it rides the guarded custom verb tracked in
// agentic-os#434 and joins the director/engineer tier once that lands.
// See ../docs/ward-specs.md.
wrap ward-kdl-merge ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "forgejo.coilysiren.me/api/v1"
    // Auth as the coilyco-ops bot (ward#151), matching the monolith surface.
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/coilyco-ops/api-token"
    }
    // Scope gate: every leaf whose path carries {owner} must name a coily* owner.
    restrict owner matches coily*
    can is-merged pr {
        op repoPullRequestIsMerged
        describe "whether a PR is already merged (GET /repos/{owner}/{repo}/pulls/{index}/merge): the idempotent pre-flight read beside `pr merge`. op pinned like the monolith's pr leaves - the bare convention does not reach the merge sub-resource."
    }
    can merge pr {
        op repoMergePullRequest
        describe "merge a pull request (POST /repos/{owner}/{repo}/pulls/{index}/merge) - the director-completion verb (agentic-os#446). Backs `ward agent director merge`: merge only a PR whose issue thread authorizes director merge, never as a blanket sweep. {owner}-scoped by the coily* gate above; bound to the director and engineer roles only (roles.kdl), never the shared read/write tiers advisor and qa inherit."
    }
}
