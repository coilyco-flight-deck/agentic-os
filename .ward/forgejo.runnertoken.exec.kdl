// Forgejo runner-token exec bridge. This stays thin on purpose: the HTTP
// request is owned by forgejo.runnertoken.kdl, and this leaf only
// routes the user-facing scope form onto the matching fetch leaf.
wrap aos-ward ops forgejo {
    exec python3
    can run "actions generate-runner-token" {
        argv ".ward/forgejo-runner-token.py"
        when arg0 matches global org repo
        describe "mint a Forgejo Actions runner registration token: `global`, `org <org>`, or `repo <owner> <repo>`"
    }
}
