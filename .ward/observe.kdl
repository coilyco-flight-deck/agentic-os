// Engineer and QA live-observation boundary.
//
// This surface is intentionally separate from ops kubectl. It grants bounded,
// read-only evidence without inheriting deploy, rollback, or shell-equivalent
// verbs from kubectl.kdl.
wrap aos-ward ops observe {
    exec kubectl

    // Resource state. Secret-bearing and extensible custom resources are absent.
    can run "get pods" {
        describe "list pod state"
    }
    can run "get deployments" {
        describe "list deployment state"
    }
    can run "get statefulsets" {
        describe "list stateful-set state"
    }
    can run "get daemonsets" {
        describe "list daemon-set state"
    }
    can run "get replicasets" {
        describe "list replica-set state"
    }
    can run "get jobs" {
        describe "list job state"
    }
    can run "get cronjobs" {
        describe "list scheduled-job state"
    }
    can run "get nodes" {
        describe "list node state"
    }
    can run "get namespaces" {
        describe "list namespaces"
    }
    can run "get services" {
        describe "list service state"
    }
    can run "get endpoints" {
        describe "list service endpoints"
    }
    can run "get ingresses" {
        describe "list ingress state"
    }
    can run "get persistentvolumeclaims" {
        describe "list persistent-volume claim state"
    }
    can run "get persistentvolumes" {
        describe "list persistent-volume state"
    }
    can run "get networkpolicies" {
        describe "list network-policy state"
    }
    can run "get horizontalpodautoscalers" {
        describe "list autoscaler state"
    }
    can run "get componentstatuses" {
        describe "read control-plane component health"
    }

    can run "describe pods" {
        describe "inspect pod state and events"
    }
    can run "describe deployments" {
        describe "inspect deployment state and events"
    }
    can run "describe statefulsets" {
        describe "inspect stateful-set state and events"
    }
    can run "describe daemonsets" {
        describe "inspect daemon-set state and events"
    }
    can run "describe replicasets" {
        describe "inspect replica-set state and events"
    }
    can run "describe jobs" {
        describe "inspect job state and events"
    }
    can run "describe cronjobs" {
        describe "inspect scheduled-job state and events"
    }
    can run "describe nodes" {
        describe "inspect node state and events"
    }
    can run "describe namespaces" {
        describe "inspect namespace state"
    }
    can run "describe services" {
        describe "inspect service state"
    }
    can run "describe endpoints" {
        describe "inspect service endpoints"
    }
    can run "describe ingresses" {
        describe "inspect ingress state and events"
    }
    can run "describe persistentvolumeclaims" {
        describe "inspect persistent-volume claim state"
    }
    can run "describe persistentvolumes" {
        describe "inspect persistent-volume state"
    }
    can run "describe networkpolicies" {
        describe "inspect network-policy state"
    }
    can run "describe horizontalpodautoscalers" {
        describe "inspect autoscaler state"
    }

    // Logs, events, metrics, health, and rollout evidence.
    can run logs {
        describe "read pod or workload logs"
    }
    can run events {
        describe "read cluster events"
    }
    can run "top pods" {
        describe "read pod resource metrics"
    }
    can run "top nodes" {
        describe "read node resource metrics"
    }
    can run cluster-info {
        describe "read control-plane and addon endpoints"
    }
    can run version {
        describe "read client and server versions"
    }
    can run api-resources {
        describe "list served resource types"
    }
    can run api-versions {
        describe "list served API group versions"
    }
    can run explain {
        describe "read resource schema documentation"
    }
    can run "rollout status" {
        describe "observe rollout completion"
    }

    // Defense in depth. Unlisted verbs are denied, and these boundaries stay
    // explicit for audits and runtime regression tests.
    never run "get secrets"
    never run "describe secrets"
    never run apply
    never run create
    never run replace
    never run delete
    never run edit
    never run patch
    never run scale
    never run expose
    never run run
    never run exec
    never run attach
    never run cp
    never run port-forward
    never run proxy
    never run debug
    never run drain
    never run cordon
    never run uncordon
    never run taint
    never run label
    never run annotate
    never run set
    never run "rollout restart"
    never run "rollout undo"
    never run "auth token"
    never run "config view"
}
