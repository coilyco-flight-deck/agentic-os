// Forgejo Actions rerun overlay. The live deployment does not expose a stable
// rerun control, so the bridge falls back to workflow dispatch for the same
// ref. Keep the rerun verbs in a tiny exec bridge with the bot token only.
wrap ward-kdl ops forgejo {
    exec bash {
        env FORGEJO_TOKEN {
            value ssm "/forgejo/api-token"
        }
    }
    can run "actions rerun" {
        when arg0 matches coily*
        argv ".ward/forgejo-actions-rerun.sh"
        describe "Rerun an existing workflow run by run id. The bridge tries the web rerun control first and falls back to workflow dispatch for the same ref when Forgejo does not expose rerun."
    }
    can run "actions rerun-failed-jobs" {
        when arg0 matches coily*
        argv ".ward/forgejo-actions-rerun-failed-jobs.sh"
        describe "Rerun only the failed jobs in an existing workflow run by run id when Forgejo exposes the job rerun controls, otherwise dispatch the workflow file for the same ref."
    }
}
