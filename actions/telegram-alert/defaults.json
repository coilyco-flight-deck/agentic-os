{
  "schema-version": 1,
  "uses": "https://forgejo.coilysiren.me/coilyco-flight-deck/agentic-os/actions/telegram-alert@main",
  "workflow": {
    "ref": "refs/heads/main",
    "continue-on-error": true
  },
  "secrets": {
    "bot-token": {
      "actions-secret": "TELEGRAM_BOT_TOKEN",
      "ssm-parameter": "/coilysiren/telegram/bot-token"
    },
    "chat-id": {
      "actions-secret": "TELEGRAM_RED_CHAT_ID",
      "ssm-parameter": "/coilysiren/telegram/red-chat-id"
    }
  }
}
