// aosguard ops aws - the AWS CLI surface as an allowlist (umbra execverb).
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops aws {
    exec aws
    // identity - nothing to guard
    can run sts get-caller-identity
    can run sts get-session-token
    // ssm parameters - the --name kwarg is the resource
    can run ssm get-parameter {
        deny-when name matches "*/prod/*" *secret*
    }
    can run ssm get-parameters-by-path
    can run ssm put-parameter {
        // Values must come from an absolute file. The guarded argv and audit log
        // carry only the file URI, never the parameter contents.
        when name matches "/*"
        when value matches "file:///*"
        when type matches String StringList SecureString
        allow-flag --name
        allow-flag --value
        allow-flag --type
        allow-flag --overwrite
        allow-flag --no-overwrite
        allow-flag --description
        allow-flag --allowed-pattern
        allow-flag --key-id
        allow-flag --tier
        allow-flag --data-type
        allow-flag --tags
        describe "create or overwrite an SSM parameter from an absolute file source without placing its value in argv"
    }
    can run ssm delete-parameter {
        when name matches "/*"
        allow-flag --name
        describe "delete one explicitly named SSM parameter"
    }
    // s3 - the resource is a positional s3:// uri
    can run s3 ls {
        deny-when arg0 matches *tfstate* *-backup*
    }
    can run s3 cp
    can run s3 sync
    can run ec2 describe-instances
    can run ec2 describe-security-groups
}
